run = "bash -lc 'npm --prefix frontend ci && npm --prefix frontend run build && cargo run --manifest-path backend/Cargo.toml'"
modules = ["nodejs-20", "rust-stable"]

[nix]
channel = "stable-24.05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm --prefix frontend install && npm --prefix frontend run build && PORT=5000 cargo run --manifest-path backend/Cargo.toml"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "./backend/target/release/backend"]
build = ["bash", "-c", "npm --prefix frontend install && npm --prefix frontend run build && cargo build --release --manifest-path backend/Cargo.toml"]
